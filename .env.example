# Скопируй значения в Vercel -> Project Settings -> Environment Variables
# (локальный .env нужен только для `vercel dev`, в git не коммитить)

# Токен бота, полученный у @BotFather
TELEGRAM_TOKEN=

# Твой chat_id, узнать у @userinfobot
TELEGRAM_CHAT_ID=

# Как часто проверять новые объявления по умолчанию (в секундах)
# Поменять "на лету" можно командой /interval <секунды> в Telegram-боте
CHECK_INTERVAL_SECONDS=300

# Минимально допустимый интервал для команды /interval
MIN_CHECK_INTERVAL_SECONDS=30

# Сколько проверок подряд без единого объявления считать подозрительным
MAX_CONSECUTIVE_EMPTY=3

# Во сколько раз максимум увеличивать паузу между проверками при
# подозрении на блокировку (экспоненциальный бэкофф с потолком)
MAX_BACKOFF_MULTIPLIER=8

# Сколько секунд ждать, пока JS отрисует карточки объявлений
PAGE_LOAD_WAIT_SECONDS=15

# Опционально: своя ссылка на выдачу re.kufar.by
# TARGET_URL=https://re.kufar.by/l/grodno/snyat/kvartiru/1k?cur=USD&prc=r%3A0%2C200

# Секрет для защиты /api/cron от внешних вызовов (см. README).
# Придумай любую случайную строку (например: openssl rand -hex 32) и укажи
# её тут же и в настройках твоего внешнего cron-сервиса как заголовок
# "Authorization: Bearer <эта строка>" при вызове /api/cron.
CRON_SECRET=

# KV_REST_API_URL / KV_REST_API_TOKEN — подставляются автоматически,
# когда в разделе Storage проекта на Vercel подключаешь Vercel KV
# (или маркетплейс-интеграцию Upstash for Redis). Вручную задавать не нужно.
